{
  "manifest_version": 3,
  "name": "Glassboard 4.0 — Liquid Dashboard",
  "version": "4.0.0",
  "description": "Apple-inspired Liquid Glass new tab dashboard with customizable widgets, dock, bookmarks, notes and weather.",
  "permissions": [
    "storage",
    "bookmarks"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://www.google.com/*",
    "https://suggestqueries.google.com/*",
    "https://www.google.com/s2/favicons/*",
    "https://icons.duckduckgo.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}