{
  "manifest_version": 3,
  "name": "GlassHome Extension by TrongDepTryy",
  "version": "4.1.0",
  "description": "GlassHome Extension by TrongDepTryy - Glass dashboard with customizable layout, clock, and reminders.",
  "permissions": [
    "storage",
    "bookmarks",
    "alarms"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://www.google.com/*",
    "https://suggestqueries.google.com/*",
    "https://www.google.com/s2/favicons/*",
    "https://icons.duckduckgo.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "reminders-background.js"
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}